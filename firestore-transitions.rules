// ============================================================
// Firestore rules — `transitions` collection (Transition Timer)
//
// This is NOT a whole rules file. The agenda board writes into the
// SAME Firebase project as the help queue (`herrick-help-queue`),
// which already has rules published for its own `rooms` collection.
// Replacing those would break the queue.
//
// HOW TO INSTALL
//   1. Firebase console -> Build -> Firestore Database -> Rules tab.
//   2. Find the existing `match /databases/{database}/documents {` line.
//   3. Paste the `match /transitions/{recordId}` block below INSIDE
//      those braces, alongside the rooms block that's already there.
//   4. Publish.
//
// WHAT THESE ALLOW
//   Anyone who can reach the page can read and write transition
//   records — the same trust level as the help queue, and for the
//   same reason: GitHub Pages serves static files with no server of
//   its own to authenticate against. What's stored is a stopwatch
//   reading, a date, and a period name. No student names, no PII,
//   nothing that matters if a stranger reads it.
//
//   The validation below is about keeping *bad data* out of the
//   table, not keeping people out: it pins the shape of a record so
//   a malformed or oversized write can't land in the collection.
// ============================================================

match /transitions/{recordId} {

  function validRecord(d) {
    return d.keys().hasOnly([
             'date', 'weekday', 'period', 'periodSlug', 'grade',
             'schedule', 'bellStart', 'bellEnd', 'seconds',
             'stopped', 'final', 'updatedAt'
           ])
           && d.date is string
           && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
           && d.period is string && d.period.size() < 40
           && d.periodSlug in ['4', '6', '7']
           && d.seconds is number
           && d.seconds >= 0
           // a single period is never longer than two hours — anything
           // past that is a bug or junk, not a transition
           && d.seconds <= 7200
           && d.stopped is bool;
  }

  allow read: if true;
  allow create, update: if validRecord(request.resource.data);
  allow delete: if true;
}
